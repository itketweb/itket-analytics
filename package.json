{
  "name": "itket-analytics",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "description": "itket.com GA4 월간 대시보드 (React + TypeScript + SCSS + Vite)",
  "scripts": {
    "dev": "vite",
    "sync:quotes": "node scripts/sync-godomall-quotes.mjs",
    "build": "node scripts/sync-godomall-quotes.mjs && tsc -b && node scripts/build-site.mjs",
    "preview": "vite preview --outDir site",
    "typecheck": "tsc -b",
    "collect": "node scripts/collect.mjs",
    "mock": "GA4_MOCK=1 DATA_DIR=.sample/data SITE_DIR=.sample/site node scripts/collect.mjs && DATA_DIR=.sample/data SITE_DIR=.sample/site node scripts/build-site.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
